          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán tus partidas, retos, rachas, logros y recompensas en este dispositivo y en iCloud. Los puntajes que ya están en las clasificaciones de Game Center se quedan ahí. No se puede deshacer."
          }
        }
      }
