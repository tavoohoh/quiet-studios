    "10": {
      "shouldTranslate": false
    },
    "10 to 30 points per digit, by level. Solve it for 500 more, doubled if you're fast.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De 10 a 30 puntos por número, según el nivel. Al resolverlo, 500 más, el doble si eres rápido."
          }
        }
      }
    },
    "2": {
      "shouldTranslate": false
    },
    "2-String Kite": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cometa (2-String Kite)"
          }
        }
      }
    },
    "3": {
      "shouldTranslate": false
    },
    "4": {
      "shouldTranslate": false
    },
    "5": {
      "shouldTranslate": false
    },
    "6": {
      "shouldTranslate": false
