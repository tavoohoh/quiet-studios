  "strings": {
    "": {
      "shouldTranslate": false
    },
    "%@ won today's challenge with %@. Up for it?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ganó el reto de hoy con %2$@. ¿Te animas?"
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld digits don't fit. Fix them.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld digit doesn't fit. Fix it."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld digits don't fit. Fix them."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld número no va. Corrígelo."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld números no van. Corrígelos."
                }
              }
            }
          }
        }
      }
    },
    "%lld friends already played; %@ leads with %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld amigos ya lo jugaron; %2$@ lidera con %3$@."
          }
        }
      }
    },
