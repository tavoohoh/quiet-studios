      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barrendero"
          }
        }
      }
    },
    "Take your score below zero.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva tu puntaje por debajo de cero."
          }
        }
      }
    },
    "Tap to match, or drag from one number to the other. Hints show a pair, for a few points.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para juntar, o arrastra de un número al otro. Las pistas te muestran una pareja, a cambio de unos puntos."
          }
        }
      }
    },
    "Teal & Coral": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Petróleo y coral"
          }
        }
      }
    },
    "The board reads like a page: the end of a row connects to the start of the next. Match the 9 and the 1.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tablero se lee como una página: el final de una fila conecta con el inicio de la siguiente. Junta el 9 y el 1."
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        }
      }
    },
