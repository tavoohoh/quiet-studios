      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ola"
          }
        }
      }
    },
    "With only cleared cells between them, numbers still connect, and it's worth more: 4 points. Match the 7 and the 3.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si entre dos números solo hay casillas vacías, igual se conectan, y vale más: 4 puntos. Junta el 7 y el 3."
          }
        }
      }
    },
    "You're ready": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Listo!"
          }
        }
      }
    },
    "Your 5-minute break.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pausa de 5 minutos."
          }
        }
      }
    },
    "Your games, daily challenge results, streaks, achievements and unlocked rewards will be deleted on this device and in iCloud. Scores already on Game Center leaderboards stay there. This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán tus partidas, resultados del reto diario, rachas, logros y recompensas desbloqueadas en este dispositivo y en iCloud. Los puntajes que ya están en los leaderboards de Game Center se quedan ahí. No se puede deshacer."
          }
        }
      }
    },
    "Your stats": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus estadísticas"
          }
        }
      }
    }
