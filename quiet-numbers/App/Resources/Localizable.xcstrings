    "Quiet Numbers doesn't collect any data. Your games, streaks and achievements stay on this device. If you sign in to Game Center, your scores and achievements are shared with Apple's Game Center.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet Numbers no recolecta ningún dato. Tus partidas, rachas y logros se quedan en este dispositivo. Si inicias sesión en Game Center, tus puntajes y logros se comparten con Game Center de Apple."
          }
        }
      }
    },
