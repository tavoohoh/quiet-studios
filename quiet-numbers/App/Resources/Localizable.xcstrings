          "stringUnit": {
            "state": "translated",
            "value": "Ajustes"
          }
        }
      }
    },
    "Sign in to Game Center in Settings to see leaderboards. Your progress is saved on this device either way.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en Game Center desde Ajustes para ver las clasificaciones. Tu progreso se guarda en este dispositivo de todas formas."
