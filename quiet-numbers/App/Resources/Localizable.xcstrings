    "Top streak": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Racha récord"
          }
        }
      }
    },
    "Triple row!": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Triple fila!"
          }
        }
      }
    },
    "Two equal numbers that touch are a pair. Match the two 5s.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos números iguales que se tocan son pareja. Junta los dos 5."
          }
        }
      }
    },
    "Two numbers that add up to 10 are a pair too, and up and down counts. Match the 4 and the 6.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos números que suman 10 también son pareja, y arriba con abajo vale. Junta el 4 y el 6."
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer"
          }
        }
      }
